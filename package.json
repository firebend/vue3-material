{
  "name": "vue-material",
  "description": "Material Design for Vue3",
  "version": "2.0.0",
  "license": "MIT",
  "author": "mcarey@firebend.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firebend/vue3-material.git"
  },
  "bugs": {
    "url": "https://github.com/firebend/vue3-material/issues"
  },
  "files": [
    "dist",
    "src"
  ],
  "main": "dist/vue-material.js",
  "module": "dist/vue-material.js",
  "unpkg": "dist/vue-material.min.js",
  "scripts": {
    "dev": "echo \"Error: no dev command\" && exit 1",
    "build": "rm -rf dist/ && mkdir -p ./dist/theme/ && echo \"Error: no dev command\" && exit 1",
    "docs": "babel-node build/docs",
    "lint": "eslint --ext .js,.vue docs src build test --fix",
    "test": "jest",
    "coverage": "yarn test --coverage",
    "githooks": "sh build/git-hooks/install.sh",
    "changelog": "babel-node build/generate-changelog.js",
    "release": "sh build/release.sh",
    "new-component": "babel-node build/new-component.js",
    "github-release": "github-release",
    "commit": "git-cz"
  },
  "engines": {
    "node": ">=v18.20.x <21",
    "pnpm": ">=9"
  },
  "peerDependencies": {
    "vue": "^3.5.16"
  },
  "dependencies": {
    "@vue/compat": "3.5.16",
    "@vue/compiler-sfc": "3.5.16",
    "regenerator-runtime": "^0.14.1",
    "tapable": "2.2.2",
    "vue-github-button": "^3.1.3",
    "vue-github-buttons": "^3.1.0",
    "vue-toc": "0.0.2"
  },
  "devDependencies": {
    "@nx/eslint": "20.8.0",
    "@nx/jest": "20.8.0",
    "@nx/vite": "20.8.0",
    "@nx/web": "20.8.0",
    "@typescript-eslint/parser": "^8.19.0",
    "@typescript-eslint/utils": "^8.19.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/ui": "^3.0.0",
    "@vue/eslint-config-typescript": "^11.0.3",
    "@vue/test-utils": "^2.4.6",
    "@vue/vue3-jest": "^29.2.6",
    "autoprefixer": "^10.4.21",
    "axios": "^1.10.0",
    "chalk": "^5.4.1",
    "clipboard": "^2.0.11",
    "codesandbox": "^2.2.3",
    "commitizen": "^4.3.1",
    "concat": "^3.0.0",
    "connect-history-api-fallback": "^2.0.0",
    "conventional-changelog": "^7.1.0",
    "conventional-changelog-vue-material": "^0.0.1",
    "css-loader": "7.1.2",
    "cz-conventional-changelog": "^3.3.0",
    "date-fns": "^4.0.0-alpha.1",
    "deepmerge": "^4.3.1",
    "eslint": "^9.8.0",
    "eslint-plugin-jest": "28.14.0",
    "eslint-plugin-jest-extended": "^3.0.0",
    "eslint-plugin-vue": "^10.2.0",
    "eventsource-polyfill": "^0.9.6",
    "express": "^5.1.0",
    "fast-deep-equal": "^3.1.3",
    "fuzzysearch": "^1.0.3",
    "github-release-cli": "^2.1.0",
    "highlight.js": "^11.11.1",
    "is-firefox": "^1.0.3",
    "is-promise": "^4.0.0",
    "jest": "^30.0.0",
    "jest-localstorage-mock": "^2.4.26",
    "jiti": "2.4.2",
    "nx": "20.8.0",
    "offline-plugin": "^5.0.7",
    "optimize-js-plugin": "^0.0.4",
    "ora": "^8.2.0",
    "popper.js": "^1.16.1",
    "postcss": "^8.5.6",
    "pretty": "^2.0.0",
    "raf": "^3.4.1",
    "sass": "1.89.2",
    "sinon": "^21.0.0",
    "syncpack": "14.0.0-alpha.14",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.3.5",
    "vitest": "^3.0.0",
    "vue": "3.5.16",
    "vue-ga": "^1.1.0",
    "vue-i18n": "^11.1.5",
    "vue-router": "^4.5.1",
    "vuelidate": "^0.7.7",
    "vuex": "^4.1.0",
    "vuex-router-sync": "^5.0.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "jest": {
    "moduleNameMapper": {
      "^vue$": "<rootDir>/node_modules/vue/dist/vue.common.js",
      "^vue-material(.*)$": "<rootDir>/src$1",
      "^test(.*)$": "<rootDir>/test$1",
      "^src(.*)$": "<rootDir>/src$1",
      "^theme(.*)$": "<rootDir>/src/theme$1",
      "^base(.*)$": "<rootDir>/src/base$1",
      "^core(.*)$": "<rootDir>/src/core$1",
      "^components(.*)$": "<rootDir>/src/components$1",
      "\\.(css|scss)$": "<rootDir>/test/styleMock.js"
    },
    "moduleFileExtensions": [
      "js",
      "json",
      "vue"
    ],
    "setupTestFrameworkScriptFile": "<rootDir>/test/setup.js",
    "collectCoverageFrom": [
      "src/**/*.{js,vue}",
      "!src/**/index.js",
      "!src/**/*.test.js"
    ],
    "coverageReporters": [
      "lcov",
      "json",
      "html"
    ],
    "testURL": "http://localhost:8080"
  },
  "browserslist": [
    "> 1%"
  ],
  "homepage": "https://github.com/vuematerial/vue-material#readme",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "keywords": [
    "vue3",
    "material",
    "design"
  ]
}
